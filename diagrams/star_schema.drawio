<mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;PK = primary key (surrogate key) &amp;nbsp;|&amp;nbsp; FK = foreign key&lt;br&gt;NK = natural key from the source system &amp;nbsp;|&amp;nbsp; DD = degenerate dimension&lt;br&gt;[A] additive &amp;nbsp;|&amp;nbsp; [S] semi-additive &amp;nbsp;|&amp;nbsp; [N] non-additive measure&lt;br&gt;Line: one dimension row (||) to many fact rows (crow's foot)&lt;br&gt;dim_date is role-playing: linked twice (appointment date, booking date)" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=11;"><mxGeometry x="930" y="950" width="440" height="115" as="geometry" /></mxCell></root></mxGraphModel>
